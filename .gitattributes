# Auto detect text files and perform LF normalization
* text=auto

# Documents
*.md text
*.txt text
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Data files
*.csv text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Power BI / BI project files
*.pbix binary
*.pbit binary

# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Archives
*.zip binary
*.rar binary
*.7z binary
*.gz binary

# Ensure line endings for source code
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sql text eol=lf
