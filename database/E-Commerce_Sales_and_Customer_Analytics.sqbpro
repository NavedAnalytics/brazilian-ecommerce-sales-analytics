<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="E-Commerce_Sales_and_Customer_Analytics.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="query browser structure pragmas" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="7803"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="olist_ecommerce_clean" custom_title="0" dock_id="2" table="4,21:mainolist_ecommerce_clean"/><dock_state state="000000ff00000000fd00000001000000020000039100000268fc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000000003910000000000000000fb000000160064006f0063006b00420072006f00770073006500320100000000000003910000013f00ffffff0000026a0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="olist_ecommerce_clean" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="263"/><column index="2" value="263"/><column index="3" value="95"/><column index="4" value="167"/><column index="5" value="159"/><column index="6" value="177"/><column index="7" value="193"/><column index="8" value="190"/><column index="9" value="263"/><column index="10" value="159"/><column index="11" value="223"/><column index="12" value="99"/><column index="13" value="89"/><column index="14" value="263"/><column index="15" value="263"/><column index="16" value="159"/><column index="17" value="55"/><column index="18" value="84"/><column index="19" value="300"/><column index="20" value="134"/><column index="21" value="165"/><column index="22" value="124"/><column index="23" value="111"/><column index="24" value="119"/><column index="25" value="119"/><column index="26" value="114"/><column index="27" value="300"/><column index="28" value="136"/><column index="29" value="207"/><column index="30" value="76"/><column index="31" value="125"/><column index="32" value="95"/><column index="33" value="136"/><column index="34" value="97"/><column index="35" value="263"/><column index="36" value="84"/><column index="37" value="207"/><column index="38" value="300"/><column index="39" value="133"/><column index="40" value="163"/><column index="41" value="93"/><column index="42" value="103"/><column index="43" value="52"/><column index="44" value="87"/><column index="45" value="90"/><column index="46" value="35"/><column index="47" value="80"/><column index="48" value="70"/><column index="49" value="87"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- TotalRevenue
select sum(total_price) as Total_Revenue
from olist_ecommerce_clean
where order_status='delivered';	


-- Total Orders
select count(DISTINCT(order_id)) as Total_Orders
from olist_ecommerce_clean;

	
-- Avg Order Value		
SELECT 
    AVG(order_value) AS avg_order_value
FROM (
    SELECT 
        order_id,
        SUM(total_price) AS order_value
    FROM olist_ecommerce_clean
    WHERE order_status = 'delivered'
    GROUP BY order_id
)t;	

-- Avg Delivery Days
select avg(Delivery_Days) as Avg_Delivery_Days
from olist_ecommerce_clean
where order_status='delivered' and Delivery_Days is not NULL;



-- Avg Review Score
select avg(max_review_score) as Avg_Review_Score
from (select order_id,max(review_score) as max_review_score
from olist_ecommerce_clean
where order_status='delivered' and review_score is not null
group by order_id)t;


-- Order per Customer
select count(distinct order_id)* 1.0 / count(distinct customer_unique_id) as order_per_customer
from olist_ecommerce_clean;
-- 
-- 
-- Average Freight Cost/Order
select avg(sum_freight_values) as avg_freight_cost_per_order
from(select order_id,sum(freight_value) as sum_freight_values
from olist_ecommerce_clean
where order_status='delivered'
group by order_id ) t;


-- 
-- Late Delivery%
select sum(total_late_deliveries) * 100.0 / count(order_id ) as late_delivery_percent 
from(select order_id , max(Late_Delivery) as total_late_deliveries
from olist_ecommerce_clean
where order_status='delivered'
group by order_id)t;


-- Monthly Revnue Trend
select Purchase_Month,sum(total_price)
from olist_ecommerce_clean
where order_status='delivered'
group by Purchase_Month;




-- Orders by payment method  
select payment_type,count(distinct order_id) as total_counts
from olist_ecommerce_clean
group by payment_type
order by total_counts desc;


--Revenue by state
select customer_state,sum(total_price) as Total_Revenue
from olist_ecommerce_clean
where order_status='delivered'
group by customer_state
order by Total_Revenue desc;

</sql><current_tab id="0"/></tab_sql></sqlb_project>
